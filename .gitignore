# Dependencies
node_modules/

# A global gitignore may exclude all .npmrc files because they often hold
# registry tokens. The CLI copy is a public registry pin, not a secret.
!packages/cli/.npmrc

# OS files
.DS_Store

# Editor
.idea/
.vscode/
*.swp

# Cursor
.cursor/mcp.json

# Environment / secrets
.env
.env.*
*.pem

# MCP configs — may contain access tokens or internal tooling references
.mcp.json

# Claude Code local settings — contains user-specific paths and plugins
.claude/settings.local.json

# uSpec component-md extraction cache (temp JSONs from extract-* skills)
.uspec-cache/

# Rendered skill artifacts. The platform-neutral source of truth lives in
# `skills/` and `references/` at the repo root; the directories below are
# generated by `npx uspec-skills install` (or the in-repo `uspec-skills render` dev command).
.cursor/skills/
.claude/skills/
.agents/skills/

# CLI build artifacts
packages/cli/dist/
packages/cli/templates/

# Throwaway React scratch project for validating generated component-md specs.
# Not part of the open-source distribution.
component-example/

# Local component-md outputs from running create-component-md against the
# maintainer's own design system. Not part of the open-source distribution —
# consumer projects DO track their own components/ folder.
components/

# Organization-only Figma plugin ids (internal Uber publication).
figma-plugin/editions.local.json
